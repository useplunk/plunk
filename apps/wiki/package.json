{
  "name": "wiki",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "node scripts/generate-openapi.js && npx tsx scripts/generate-docs.mts && fumadocs-mdx",
    "build": "next build",
    "sitemap": "next-sitemap --config next-sitemap.config.mjs",
    "predev": "node scripts/generate-openapi.js && npx tsx scripts/generate-docs.mts && fumadocs-mdx",
    "dev": "next dev --turbo --port 1000",
    "start": "next start",
    "postinstall": "fumadocs-mdx",
    "generate-docs": "node scripts/generate-openapi.js && npx tsx scripts/generate-docs.mts",
    "lint": "eslint .",
    "clean": "rimraf node_modules .next .turbo"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "fumadocs-core": "16.8.9",
    "fumadocs-mdx": "15.0.2",
    "fumadocs-openapi": "^10.8.2",
    "fumadocs-ui": "16.8.9",
    "lucide-react": "^1.14.0",
    "next": "^16.2.6",
    "next-sitemap": "^4.2.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwind-merge": "^3.6.0",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@types/mdx": "^2.0.13",
    "@types/node": "^25.6.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "postcss": "^8.5.14",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3"
  }
}
