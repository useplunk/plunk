    "@vitest/ui": "^4.1.0",
    "dotenv": "^17.0.1",
    "eslint": "^9.27.0",
    "eslint-config-next": "^16.0.1",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-import": "^2.31.0",
    "form-data": "^4.0.6",
    "prettier": "^3.5.3",
    "rimraf": "^6.1.2",
    "supertest": "^7.1.4",
    "turbo": "^2.9.14",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.48.0",
    "vitest": "^4.1.0",
    "vitest-mock-extended": "^3.1.0"
  },
  "engines": {
