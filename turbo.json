{
  "$schema": "https://turbo.build/schema.json",
  "remoteCache": {
    "signature": false
  },
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "NODE_ENV",
        "DATABASE_URL",
        "DIRECT_DATABASE_URL",
        "API_URI",
        "DASHBOARD_URI",
        "LANDING_URI",
        "WIKI_URI",
        "NEXT_PUBLIC_API_URI",
        "NEXT_PUBLIC_LANDING_URI",
        "NEXT_PUBLIC_DASHBOARD_URI",
        "NEXT_PUBLIC_WIKI_URI"
      ],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "sitemap": {
      "dependsOn": ["build"],
      "outputs": ["public/robots.txt", "public/sitemap*.xml"]
    },
    "deploy": {
      "dependsOn": ["build", "sitemap"],
      "outputs": []
    },
    "start": {
      "dependsOn": ["^start"],
      "env": [
        "NODE_ENV",
        "PORT",
        "JWT_SECRET",
        "DATABASE_URL",
        "DIRECT_DATABASE_URL",
        "REDIS_URL",
        "API_URI",
        "DASHBOARD_URI",
        "LANDING_URI",
        "WIKI_URI",
        "AZURE_STORAGE_CONNECTION_STRING",
        "AZURE_STORAGE_CONTAINER",
        "AZURE_STORAGE_PUBLIC_URL",
        "AWS_SES_REGION",
        "AWS_SES_ACCESS_KEY_ID",
        "AWS_SES_SECRET_ACCESS_KEY",
        "SES_CONFIGURATION_SET",
        "SES_CONFIGURATION_SET_NO_TRACKING",
        "EMAIL_RATE_LIMIT_PER_SECOND",
        "GITHUB_OAUTH_CLIENT",
        "GITHUB_OAUTH_SECRET",
        "GOOGLE_OAUTH_CLIENT",
        "GOOGLE_OAUTH_SECRET",
        "NEXT_PUBLIC_API_URI",
        "NEXT_PUBLIC_LANDING_URI",
        "NEXT_PUBLIC_DASHBOARD_URI",
        "NEXT_PUBLIC_WIKI_URI",
        "PLUNK_API_KEY",
        "PLUNK_FROM_ADDRESS",
        "NTFY_URL",
        "SMTP_ENABLED",
        "SMTP_DOMAIN",
        "PORT_SECURE",
        "PORT_SUBMISSION",
        "AUTO_PROJECT_DISABLE",
        "DISABLE_SIGNUPS",
        "VERIFY_EMAIL_ON_SIGNUP"
      ],
      "inputs": ["$TURBO_DEFAULT$", ".env*"]
    },
    "lint": {
      "dependsOn": ["^lint"],
      "cache": false,
      "persistent": true
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": [
        "NODE_ENV",
        "PORT",
        "JWT_SECRET",
        "DATABASE_URL",
        "DIRECT_DATABASE_URL",
        "REDIS_URL",
        "API_URI",
        "DASHBOARD_URI",
        "LANDING_URI",
        "WIKI_URI",
        "AZURE_STORAGE_CONNECTION_STRING",
        "AZURE_STORAGE_CONTAINER",
        "AZURE_STORAGE_PUBLIC_URL",
        "AWS_SES_REGION",
        "AWS_SES_ACCESS_KEY_ID",
        "AWS_SES_SECRET_ACCESS_KEY",
        "SES_CONFIGURATION_SET",
        "SES_CONFIGURATION_SET_NO_TRACKING",
        "EMAIL_RATE_LIMIT_PER_SECOND",
        "GITHUB_OAUTH_CLIENT",
        "GITHUB_OAUTH_SECRET",
        "GOOGLE_OAUTH_CLIENT",
        "GOOGLE_OAUTH_SECRET",
        "NEXT_PUBLIC_API_URI",
        "NEXT_PUBLIC_LANDING_URI",
        "NEXT_PUBLIC_DASHBOARD_URI",
        "NEXT_PUBLIC_WIKI_URI",
        "PLUNK_API_KEY",
        "PLUNK_FROM_ADDRESS",
        "NTFY_URL",
        "SMTP_ENABLED",
        "SMTP_DOMAIN",
        "PORT_SECURE",
        "PORT_SUBMISSION",
        "AUTO_PROJECT_DISABLE",
        "DISABLE_SIGNUPS",
        "VERIFY_EMAIL_ON_SIGNUP"
      ]
    },
    "dev:worker": {
      "cache": false,
      "persistent": true,
      "env": [
        "NODE_ENV",
        "PORT",
        "JWT_SECRET",
        "DATABASE_URL",
        "DIRECT_DATABASE_URL",
        "REDIS_URL",
        "API_URI",
        "DASHBOARD_URI",
        "LANDING_URI",
        "WIKI_URI",
        "AZURE_STORAGE_CONNECTION_STRING",
        "AZURE_STORAGE_CONTAINER",
        "AZURE_STORAGE_PUBLIC_URL",
        "AWS_SES_REGION",
        "AWS_SES_ACCESS_KEY_ID",
        "AWS_SES_SECRET_ACCESS_KEY",
        "SES_CONFIGURATION_SET",
        "SES_CONFIGURATION_SET_NO_TRACKING",
        "EMAIL_RATE_LIMIT_PER_SECOND",
        "GITHUB_OAUTH_CLIENT",
        "GITHUB_OAUTH_SECRET",
        "GOOGLE_OAUTH_CLIENT",
        "GOOGLE_OAUTH_SECRET",
        "NEXT_PUBLIC_API_URI",
        "NEXT_PUBLIC_LANDING_URI",
        "NEXT_PUBLIC_DASHBOARD_URI",
        "NEXT_PUBLIC_WIKI_URI",
        "PLUNK_API_KEY",
        "PLUNK_FROM_ADDRESS",
        "NTFY_URL",
        "SMTP_ENABLED",
        "SMTP_DOMAIN",
        "PORT_SECURE",
        "PORT_SUBMISSION",
        "AUTO_PROJECT_DISABLE",
        "DISABLE_SIGNUPS",
        "VERIFY_EMAIL_ON_SIGNUP"
      ]
    },
    "clean": {
      "cache": false,
      "persistent": true
    }
  }
}
